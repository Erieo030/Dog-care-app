# 必填：Backend 啟動與 MongoDB 連線
PORT=8000
MONGO_URI=mongodb://erieo:change-me@localhost:27017/app_dog_db?authSource=admin
MONGO_DB=app_dog_db

# Docker MongoDB 可選；未填時 docker-compose 使用預設值
MONGO_USERNAME=erieo
MONGO_PASSWORD=change-me

# 選填：未設定時 AI 使用 deterministic fallback
AI_PROVIDER=self_hosted
AI_MODEL_API_URL=
AI_MODEL_API_KEY=
AI_MODEL_NAME=gemma-4-26b-a4b
AI_MODEL_TIMEOUT_SECONDS=45

# AI 每日次數限制：預設關閉；開啟後使用 AI_DAILY_REQUEST_LIMIT
AI_DAILY_REQUEST_LIMIT_ENABLED=false
AI_DAILY_REQUEST_LIMIT=20

# 選填：公開協尋、CORS 與 App 資訊
PUBLIC_APP_URL=
CORS_ORIGINS=*
APP_TITLE=PawLog Backend
APP_VERSION=1.0.0
