# MEGO local development environment
# Copy this file to .env at the repository root. Never commit .env.

# ===== Backend / database =====
# [選填] ./start.sh 後端埠號；預設 8000。
PORT=8000
# [必填] MongoDB 連線；帳密需與 Docker 的 MONGO_USERNAME / MONGO_PASSWORD 相同。
MONGO_URI=mongodb://mego:change-me@localhost:27017/app_dog_db?authSource=admin
# [必填] MongoDB 資料庫名稱。
MONGO_DB=
# [必填] 至少 32 字元隨機密鑰；./start.sh 留白時會自動產生並寫回此檔。
AUTH_SECRET_KEY=
# [選填] Access Token 有效分鐘數，預設 15。
AUTH_ACCESS_TOKEN_MINUTES=15
# [選填] 閒置登入有效天數，預設且上限為 7 天；可設 1～7。
AUTH_REFRESH_TOKEN_DAYS=7
# [Docker 選填] MongoDB 管理者帳號與密碼，必須與 MONGO_URI 一致。
MONGO_USERNAME=mego
MONGO_PASSWORD=change-me

# ===== AI assistant =====
# [選填] 目前支援 self_hosted；預設 self_hosted。
AI_PROVIDER=self_hosted
# [選填／共用服務時必填] 共用外部模型服務位址與機密金鑰；各服務皆獨立設定時可留白，不可使用 EXPO_PUBLIC_ 前綴。
AI_MODEL_API_URL=
AI_MODEL_API_KEY=
# [選填] 可為文字聊天指定獨立端點／金鑰；留白時沿用 AI_MODEL_API_URL／AI_MODEL_API_KEY。
AI_CHAT_API_URL=
AI_CHAT_API_KEY=
# [選填] 可為 RAG Embedding 指定獨立端點／金鑰；留白時沿用 AI_MODEL_API_URL／AI_MODEL_API_KEY。
AI_EMBEDDING_API_URL=
AI_EMBEDDING_API_KEY=
# [選填] 可為 RAG Reranker 指定獨立端點／金鑰；留白時沿用 AI_MODEL_API_URL／AI_MODEL_API_KEY。
AI_RERANK_API_URL=
AI_RERANK_API_KEY=
# [選填] 模型名稱與一般 LLM 呼叫逾時秒數。
AI_MODEL_NAME=
AI_MODEL_TIMEOUT_SECONDS=45
# [選填] RAG 向量模型名稱；更換後重啟後端，且必須用同一模型重建知識庫 Embedding 索引。
AI_EMBEDDING_MODEL=bge-m3-embedding
# [選填] RAG 段落重排序模型名稱；更換後重啟後端，可獨立更換、不需重建向量索引。
AI_RERANK_MODEL=bge-m3-reranker
# [選填] 就醫前摘要 AI 補充整理逾時；基礎摘要不呼叫模型。
AI_VET_BRIEF_TIMEOUT_SECONDS=15
# [選填] 啟用 MEGO AI 的犬隻照護 RAG 參考資料；預設啟用，設為 false 可停用檢索、不影響一般聊天。
MEGO_RAG_ENABLED=true
# [選填] RAG 檢索總逾時秒數（預設 24）；逾時或索引不可用時會略過參考資料，仍由一般 AI 回覆。
MEGO_RAG_TIMEOUT_SECONDS=24
# [選填] RAG 最終提供給回答模型的參考段落數，範圍 1～10，預設 3。
MEGO_RAG_TOP_K=3
# [選填] 每日 AI 次數限制開關，預設關閉、不限次數。
AI_DAILY_REQUEST_LIMIT_ENABLED=false
# [條件必填] 僅在限制開關為 true 時生效；預設 20 次／帳號／台灣日期。
AI_DAILY_REQUEST_LIMIT=20

# ===== Optional stool photo classification =====
# [選填] 本機 ONNX 模型資料夾，須包含 model.onnx 與 model_meta.json；留白時停用照片分類。
STOOL_MODEL_DIR=
# [選填] 每個後端 worker 使用的 ONNX CPU 執行緒數，預設 1。
STOOL_ORT_THREADS=1

# ===== Upload storage =====
# [選填] 後端附件儲存目錄；相對路徑以專案根目錄為基準，預設 backend/uploads。
ATTACHMENT_STORAGE_DIR=backend/uploads
# [選填] 附件與便便分類照片的單檔上限 MB，預設 10，程式限制於 1～50 MB。
MEGO_UPLOAD_MAX_MB=10

# ===== API / app =====
# [選填] CORS 允許來源，逗號分隔；本機可用 *，正式環境請指定網域。
CORS_ORIGINS=*
# [選填] FastAPI 文件頁服務名稱與版本。
APP_TITLE=MEGO Backend
APP_VERSION=2.0.0

# ===== Expo / frontend =====
# [選填] Expo Go 連線方式：lan（預設）、tunnel 或 localhost。
EXPO_CONNECTION=lan
# [選填] 手機連 Backend 的完整網址。留白時 ./start.sh 自動偵測目前電腦 IP。
MEGO_API_URL=
# [由 ./start.sh 自動管理] 手動執行 Expo 時才需自行填入相同的 Backend URL。
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_BASE_URL=
# [選填] 毛孩身份 QR 公開頁網址；留白時使用 API URL。跨網路使用需公開 HTTPS 網域。
EXPO_PUBLIC_LOST_PET_BASE_URL=
# [選填／公開設定] 前端一般 AI API 請求逾時毫秒數，預設 45000。
EXPO_PUBLIC_AI_REQUEST_TIMEOUT_MS=45000
# [選填／公開設定] 前端 AI 對話請求逾時毫秒數，預設 75000。
EXPO_PUBLIC_AI_CHAT_TIMEOUT_MS=75000
# [選填／公開設定] 前端就醫摘要 AI 補充整理逾時毫秒數，預設 20000。
EXPO_PUBLIC_AI_VET_BRIEF_TIMEOUT_MS=20000

# 安全提醒：所有 EXPO_PUBLIC_* 都會被打包至 App，請勿放 API Key、密碼或私密 token。
