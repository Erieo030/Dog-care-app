# MEGO local development environment
# Copy this file to .env at the repository root. Never commit .env.

# ===== Backend / database =====
# [選填] ./start.sh 後端埠號；預設 8000。
PORT=8000
# [必填] MongoDB 連線；帳密需與 Docker 的 MONGO_USERNAME / MONGO_PASSWORD 相同。
MONGO_URI=mongodb://mego:change-me@localhost:27017/app_dog_db?authSource=admin
# [必填] MongoDB 資料庫名稱。
MONGO_DB=
# [必填] 至少 32 字元隨機密鑰；./start.sh 留白時會自動產生並寫回此檔。
AUTH_SECRET_KEY=
# [選填] Access Token 有效分鐘數，預設 15。
AUTH_ACCESS_TOKEN_MINUTES=15
# [選填] 閒置登入有效天數，預設且上限為 7 天；可設 1～7。
AUTH_REFRESH_TOKEN_DAYS=7
# [Docker 選填] MongoDB 管理者帳號與密碼，必須與 MONGO_URI 一致。
MONGO_USERNAME=mego
MONGO_PASSWORD=change-me

# ===== AI assistant =====
# [選填] 目前支援 self_hosted；預設 self_hosted。
AI_PROVIDER=self_hosted
# [使用 LLM 時必填] 外部模型服務位址與機密金鑰；不可使用 EXPO_PUBLIC_ 前綴。
AI_MODEL_API_URL=
AI_MODEL_API_KEY=
# [選填] 模型名稱與一般 LLM 呼叫逾時秒數。
AI_MODEL_NAME=
AI_MODEL_TIMEOUT_SECONDS=45
# [選填] 就醫前摘要 AI 補充整理逾時；基礎摘要不呼叫模型。
AI_VET_BRIEF_TIMEOUT_SECONDS=15
# [選填] 每日 AI 次數限制開關，預設關閉、不限次數。
AI_DAILY_REQUEST_LIMIT_ENABLED=false
# [條件必填] 僅在限制開關為 true 時生效；預設 20 次／帳號／台灣日期。
AI_DAILY_REQUEST_LIMIT=20

# ===== API / app =====
# [選填] CORS 允許來源，逗號分隔；本機可用 *，正式環境請指定網域。
CORS_ORIGINS=*
# [選填] FastAPI 文件頁服務名稱與版本。
APP_TITLE=MEGO Backend
APP_VERSION=2.0.0

# ===== Expo / frontend =====
# [選填] Expo Go 連線方式：lan（預設）、tunnel 或 localhost。
EXPO_CONNECTION=lan
# [選填] 手機連 Backend 的完整網址。留白時 ./start.sh 自動偵測目前電腦 IP。
MEGO_API_URL=
# [由 ./start.sh 自動管理] 手動執行 Expo 時才需自行填入相同的 Backend URL。
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_BASE_URL=
# [選填] 毛孩身份 QR 公開頁網址；留白時使用 API URL。跨網路使用需公開 HTTPS 網域。
EXPO_PUBLIC_LOST_PET_BASE_URL=

# 安全提醒：所有 EXPO_PUBLIC_* 都會被打包至 App，請勿放 API Key、密碼或私密 token。
