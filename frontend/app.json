{
  "expo": {
    "name": "PawLog",
    "slug": "my-app",
    "version": "1.0.0",
    "ios": {
      "bundleIdentifier": "org.name.myapp"
    },
    "android": {
      "package": "com.myapp",
      "allowBackup": false
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "允許 PawLog 選擇健康紀錄照片",
          "cameraPermission": "允許 PawLog 拍攝健康紀錄照片",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
